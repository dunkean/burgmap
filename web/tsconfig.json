{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUnusedLocals": false, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "WebWorker"], "types": ["node", "vite/client", "@webgpu/types"],
    "noEmit": true, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src", "scripts", "tests", "vite.config.ts", "vitest.config.ts", "vitest.workspace.ts"]
}
