{
  "name": "magna-urbis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:terrain": "node ../rust/scripts/terrain.mjs dev",
    "wasm:terrain": "node ../rust/scripts/terrain.mjs wasm",
    "build:terrain": "node ../rust/scripts/terrain.mjs build",
    "check:terrain": "node ../rust/scripts/terrain.mjs check",
    "build": "vite build && vite build --mode testbench",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:slow": "vitest run --project slow",
    "typecheck": "tsc --noEmit",
    "preview:png": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "fflate": "^0.8.2",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  }
}
